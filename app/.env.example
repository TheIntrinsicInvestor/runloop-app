EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_ROUTE_API_BASE=https://your-route-service.example.com
# Real value lives in the Codemagic env group `runloop_secrets` and the server's
# .env only. Never commit it here: this file is tracked.
EXPO_PUBLIC_ROUTE_API_KEY=your_route_api_key_here
# Build-time only (no EXPO_PUBLIC_ prefix -> not bundled). app.config.ts passes it to
# the @rnmapbox/maps plugin (RNMapboxMapsDownloadToken).
#
# DELIBERATELY ABSENT from the local .env: builds run on Codemagic, which supplies
# it from the `runloop_secrets` group. `expo start` does not need it. Leaving it out
# keeps the one genuinely-secret value from being written into
# .expo/dev/logs/start.log, which Expo fills with every .env value on each start —
# and that path sits in OneDrive, which cannot exclude subfolders on a personal
# account. Only add it back if you need to run `expo prebuild` locally.
MAPBOX_DOWNLOAD_TOKEN=sk.your_download_token_here
